# Option 1: Local Development (Default SQLite)
DATABASE_URL="file:./dev.db"

# Option 2: Production Cloud Hosting (Free Supabase or Neon.tech PostgreSQL)
# Example Supabase (with transaction connection pooler on port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example Neon.tech:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT-ID]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# Cloud Image Storage (Free Tier Cloudinary: 25GB free)
# Leave blank for local disk storage (dev only); configure on Vercel for zero-disk uploads:
