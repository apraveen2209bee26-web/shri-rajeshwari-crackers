datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id            Int      @id @default(autoincrement())
  sNo           Int      @unique
  name          String
  tamilName     String   @default("")
  category      String
  macroCategory String   // 'Daylight', 'Nightlight', 'Gift Boxes'
  unit          String   @default("1 Box")
  originalPrice Float    // Rate / MRP
  price         Float    // Net Rate after 80% discount
  discount      Float    @default(80.0)
  stock         Int      @default(100)
  inStock       Boolean  @default(true)
  image         String   @default("/images/illustration-diwali-crackers.avif")
  description   String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id             Int      @id @default(autoincrement())
  orderRef       String   @unique
  customerName   String
  whatsappNumber String
  address        String
  city           String
  pincode        String
  deliveryDate   String
  itemsJson      String   // Serialized cart items array
  totalMrp       Float
  totalSavings   Float
  finalAmount    Float
  status         String   @default("WhatsApp Order Initiated")
  createdAt      DateTime @default(now())
}

model AdminSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
